{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securethecloud.dev/schemas/portfolio/suite_catalog.schema.json",
  "title": "SecureTheCloud Suite Catalog Contract",
  "type": "object",
  "required": [
    "contract_name",
    "contract_version",
    "doctrine_phase",
    "last_updated",
    "sharing_status",
    "suites",
    "non_suite_substrates",
    "frozen_rules"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_name": {
      "const": "securethecloud_suite_catalog"
    },
    "contract_version": {
      "type": "string"
    },
    "doctrine_phase": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sharing_status": {
      "type": "string",
      "enum": [
        "active_machine_readable_contract"
      ]
    },
    "suites": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "suite_id",
          "suite_name",
          "status",
          "customer_offerable",
          "primary_role",
          "authority_posture",
          "shared_trust_fabric_dependencies"
        ],
        "additionalProperties": false,
        "properties": {
          "suite_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "suite_name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "customer_offerable": {
            "type": "boolean"
          },
          "primary_role": {
            "type": "string"
          },
          "authority_posture": {
            "type": "string"
          },
          "shared_trust_fabric_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "non_suite_substrates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "substrate_id",
          "name",
          "status",
          "customer_offerable",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "substrate_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "customer_offerable": {
            "type": "boolean"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "frozen_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
