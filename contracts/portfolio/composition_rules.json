{"contract_name":"securethecloud_composition_rules","contract_version":"0.3.0-machine-contract-baseline","doctrine_phase":"Phase 3 / Shared Machine-Readable Contracts","last_updated":"2026-05-23","sharing_status":"active_machine_readable_contract","canonical_summary":"Composition is packaging and orchestration; composition is not authority creation.","allowed_actions":["assemble_customer_facing_packages_from_approved_suites","present_shared_trust_fabric_metadata_through_approved_suite_surfaces","route_read_only_evidence_views","combine_evidence_summaries_from_approved_sources","reference_module_registry_entries","reference_suite_catalog_entries","reference_authority_matrix_entries","present_customer_safe_summaries","prepare_product_packaging_views"],"forbidden_actions":["create_runtime_authority","issue_tokens","grant_authorization","bypass_sentinel","perform_provider_mutation","perform_kubernetes_mutation","execute_policy_decisions_without_explicit_authority","convert_evidence_modules_into_enforcement_modules","convert_explanation_modules_into_authorization_modules","merge_customer_suite_roles_into_undefined_authority_surface","invent_status_values","invent_suite_membership","invent_module_authority"],"authority_preservation_rules":["Composed modules keep their original authority type.","Composed modules keep their callable interfaces.","Composed modules keep their forbidden actions.","Composition never upgrades authority.","Composition never erases forbidden actions.","Composition never changes SENTINEL control-point doctrine."],"sentinel_non_bypass":true,"multi_suite_package_requirements":["included_suite_list","included_module_list_when_module_level_claims_are_made","shared_trust_fabric_dependencies","explicit_authority_posture","forbidden_actions","control_point_dependency_statement","soc2_evidence_impact_statement_when_applicable"]}
